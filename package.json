{
  "name": "ai-bi",
  "private": true,
  "version": "0.1.0",
  "description": "DataMind AI-BI 企业级多智能体数据洞察平台",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @ai-bi/db generate",
    "db:migrate": "pnpm --filter @ai-bi/db migrate:dev",
    "db:deploy": "pnpm --filter @ai-bi/db migrate:deploy",
    "benchmark:db:up": "docker compose up -d benchmark-db",
    "benchmark:db:seed": "docker exec -i ai-bi-benchmark-db-1 psql -U postgres -d benchmark_bi < benchmark/seed/01-schema.sql && docker exec -i ai-bi-benchmark-db-1 psql -U postgres -d benchmark_bi < benchmark/seed/02-data.sql",
    "benchmark:setup": "tsx benchmark/scripts/setup.ts",
    "benchmark:run": "pnpm --filter @ai-bi/api benchmark:run"
  },
  "devDependencies": {
    "@ai-bi/db": "workspace:*",
    "@ai-bi/shared": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^2.4.3",
    "pg": "^8.23.0",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "yaml": "^2.9.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "volta": {
    "node": "20.20.2"
  }
}
