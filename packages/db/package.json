{
  "name": "@ai-bi/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "node --env-file=../../.env ./node_modules/prisma/build/index.js generate",
